# Talking Traffic / UDAP MQTT broker
# Toegang loopt via Monotch (de beheerder van UDAP namens NDW).
# Beheerportaal: https://udap-home.tlex.eu/
# Kaart met live iVRI's: https://map.udap.nl/app/
# Support / aanvragen: https://monotch.freshdesk.com/  (of mail Monotch direct)
# Zonder deze waarden draait de app in demomodus (gesimuleerd verkeerslicht).

UDAP_HOST=
UDAP_PORT=8883
UDAP_USERNAME=
UDAP_PASSWORD=
UDAP_USE_TLS=true

# Topics: standaard wildcard voor alle SPaT- en MAP-berichten waarvoor je
# rechten hebt. Pas aan als je een specifieke kruising wilt volgen.
UDAP_SPAT_TOPIC=topicroot/+/+/SPATEM/#
UDAP_MAP_TOPIC=topicroot/+/+/MAPEM/#

# Webserver
HOST=0.0.0.0
PORT=8000

# Zet op "true" om demomodus af te dwingen, ook als er een broker is geconfigureerd.
DEMO_MODE=false

# CORS: kommagescheiden lijst van origins die je API mogen aanroepen.
# Gebruik "*" om alles toe te staan (handig in dev, voorzichtig in productie).
# Voorbeeld voor GitHub Pages: https://idkmanlool9.github.io
CORS_ORIGINS=*
